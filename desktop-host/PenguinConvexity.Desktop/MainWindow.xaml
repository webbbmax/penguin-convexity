<Window x:Class="PenguinConvexity.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="企鹅投研-凸性"
        Icon="Assets/penguin-research-clean.ico"
        MinWidth="1180" MinHeight="760"
        Width="1440" Height="900"
        Background="#F4F9FC"
        WindowStartupLocation="CenterScreen">
  <Grid x:Name="RootGrid">
    <Grid x:Name="BrowserHost" Visibility="Collapsed" />

    <Grid x:Name="StatusLayer" Background="#F4F9FC">
      <Border Width="620" MaxWidth="720" Padding="42" Background="White"
              BorderBrush="#C9E4F2" BorderThickness="1" CornerRadius="18"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <Image Source="Assets/penguin-research-icon.png" Width="84" Height="84"
                 Stretch="Uniform" HorizontalAlignment="Left" />
          <TextBlock Text="企鹅投研-凸性" Margin="0,18,0,4" FontSize="28"
                     FontWeight="SemiBold" Foreground="{StaticResource DeepBlue}" />
          <TextBlock Text="洞见共识之外的价值" FontSize="14" Foreground="#5F7E8E" />

          <TextBlock x:Name="StatusTitle" Margin="0,34,0,8" FontSize="22"
                     FontWeight="SemiBold" Foreground="{StaticResource DeepBlue}"
                     Text="检查本地服务" />
          <TextBlock x:Name="StatusMessage" FontSize="15" Foreground="#466574"
                     TextWrapping="Wrap" LineHeight="24"
                     Text="正在确认本机页面服务是否可以使用。" />
          <TextBlock x:Name="WaitMessage" Margin="0,12,0,0" FontSize="13"
                     Foreground="#718D9B" Visibility="Collapsed" />

          <StackPanel x:Name="ActionPanel" Orientation="Horizontal" Margin="0,24,0,0"
                      Visibility="Collapsed">
            <Button x:Name="PrimaryAction" Click="PrimaryAction_Click"
                    Background="{StaticResource AntarcticBlue}" Foreground="White"
                    Content="重新检测" />
            <Button x:Name="LogAction" Click="LogAction_Click" Margin="12,0,0,0"
                    Background="#E7F3F9" Foreground="{StaticResource DeepBlue}"
                    Content="打开日志位置" />
          </StackPanel>

          <Expander x:Name="TechnicalExpander" Header="技术详情" Margin="0,18,0,0"
                    Foreground="#668392" Visibility="Collapsed">
            <TextBlock x:Name="TechnicalDetail" Margin="0,10,0,0" Padding="12"
                       Background="#F2F7FA" Foreground="#4C6877"
                       TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
          </Expander>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
