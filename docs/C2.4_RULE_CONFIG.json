  "status": "frozen",
  "ruleVersion": "c2.4-rules-v1",
  "timeDefinition": {
    "t0": "earliest_verified_public_circulation_evidence_in_supported_scope",
    "newCandidateWindowDaysInclusive": [0, 90],
    "migrateAtAgeDay": 91,
    "futureDaysCountAsZero": false,
    "firstSeenAtCanDefineAge": false,
    "ageWeight": 0,
    "minimumWaitDays": 0
  },
  "firstGate": {
    "name": "90_day_candidate_initial_screen",
    "requiredChecks": [
      "t0_verified_in_supported_scope_and_age_0_90",
      "chain_contract_pool_direction_and_stable_asset_id_determined",
      "observed_public_buys_gte_1_and_observed_public_sells_gte_1",
      "no_confirmed_freeze_blacklist_or_sell_block"
    ],
    "relationshipClassControlsEntry": false,
    "productEvidenceControlsEntry": false,
    "fixedMarketAmountThresholdsAllowed": false,
    "sellQuoteControlsEntry": false,
    "riskSupplyOrHolderSourceSuccessControlsEntry": false,
    "bayesOrStrongPathControlsEntry": false,
    "unknownRisk": "pass_to_deep_tracking_as_pending_not_safe_or_failed",
    "classD": "backend_deep_tracking_and_evidence_only_never_public"
  },
  "publicBaseline": {
    "requiredChecks": [
      "new_complete_recomputable_deep_tracking_result",
      "risk_source_success_and_no_confirmed_hard_block_or_severe_anomaly",
      "standard_sell_quote_100_usd_success_and_loss_pct_lte_15",
      "at_least_one_program_verified_asset_attributable_project_evidence",
      "t0_age_direction_and_stable_asset_id_still_valid"
    ],
    "qualifyingProjectEvidenceAnyOf": [
      "qualifying_official_code_repository",
      "deterministically_mapped_deployed_product",
      "deterministically_mapped_business_or_onchain_usage",
      "official_old_project_new_asset_relationship"
    ],
    "githubOnlyBoundary": "code_only_not_proof_of_deployment_adoption_or_investment_value",
    "classDPublicAllowed": false,
    "compositeScoreControlsEligibility": false
  },
  "sellQuote": {
    "notionalUsd": 100,
    "publicMaximumLossPct": 15,
    "backendOnlyWhenLossPctGt15AndLt20": true,
    "severeImmediateExitLossPctGte": 20,
    "missingOrNonSuccess": "backend_with_true_data_state_not_zero"
  },
