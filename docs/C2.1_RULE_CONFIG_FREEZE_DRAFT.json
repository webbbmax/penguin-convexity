    "repeatedSchedulerRunWithoutNewWindowCounts": false
  },
  "severeQAnomalies": {
    "liquidityDropPctGteBetweenComparableWindows": 80,
    "sellQuoteLossPctGte": 20,
    "supplyUnitScaleChanged": true,
    "confirmedFreezeBlacklistOrSellFailure": true,
    "poolVolumeConcentrationAloneIsSevere": false,
    "walletManipulationPerfectDetectionClaimAllowed": false
  },
  "dataQualityBlocks": {
    "crossSourcePriceDeviationPctGte": 25,
    "effect": "affected_path_unavailable_and_project_data_limited_if_current_state_cannot_be_determined",
    "projectRiskFlagCreated": false
  },
  "dataStatePolicy": {
    "states": ["success", "no_data", "quota_limited", "source_failure", "unsupported", "configuration_missing", "program_failure"],
    "missingBecomesZero": false,
    "sourceFailureChangesFundamentalScore": false,
    "lastCompleteSnapshotPreserved": true,
    "newNeverCompletedHardGateObjectStaysBackend": true,
