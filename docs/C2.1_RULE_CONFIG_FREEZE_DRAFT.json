  "cohortPercentiles": {
    "primary": {"scope": "same_chain_same_age_band_rolling_30_days", "minimumValidObjects": 20},
    "secondary": {"scope": "all_supported_chains_same_age_band_rolling_30_days", "minimumValidObjects": 50},
    "fallback": "frozen_age_band_baseline_in_this_file",
    "invalidValuesExcluded": true,
    "missingValuesExcludedFromMetricDenominatorOnly": true,
    "missingValuesBecomeZero": false
  },
  "comparisonWindows": {
    "age_0_2": {"unit": "hour", "minimumWidth": 6, "maximumWidth": 24, "rule": "two_equal_trailing_completed_windows"},
    "age_3_6": {"unit": "hour", "minimumWidth": 6, "maximumWidth": 24, "rule": "two_equal_trailing_completed_windows"},
    "age_7_13": {"unit": "day", "width": 3, "rule": "previous_3_completed_days_vs_current_3_completed_days"},
    "age_14_30": {"unit": "day", "width": 3, "rule": "previous_3_completed_days_vs_current_3_completed_days"},
    "age_31_90": {"unit": "day", "width": 7, "rule": "previous_7_completed_days_vs_current_7_completed_days"}
  },
  "hardGate": {
    "requiredChecks": [
      "t0_verified_in_supported_scope",
      "within_0_90_days",
      "relationship_class_A_B_or_C",
      "asset_pool_direction_consistent",
      "observed_public_buy",
      "observed_public_sell",
      "no_confirmed_hard_trade_block",
      "qualifying_product_evidence"
    ],
    "fixedMarketAmountThresholdsAllowed": false,
    "compositeScoreCanControlFrontEligibility": false,
    "frontVisibleMustEqualHardGatePassed": true
  },
  "strongPaths": {
    "trade_liquidity_formation": {
      "requiredForConvexityClue": true,
      "requiredSourceTypes": ["market_pool_data", "sell_quote_or_verified_route"],
      "formedWhenAll": [
        "latest_liquidity_usd_gte_max_cohort_p60_and_age_floor",
        "observed_buys_gte_1_and_observed_sells_gte_1",
        "at_least_2_of_volume_transactions_volume_liquidity_ratio_gte_cohort_p60",
        "standard_sell_quote_100_usd_state_success",
        "standard_sell_quote_loss_pct_lte_10",
        "no_severe_q_anomaly"
      ],
      "quote": {"notionalUsd": 100, "maximumLossPct": 10, "missingOrUnsupported": "path_unavailable_not_zero"}
    },
    "verified_product_usage_expansion": {
      "requiredForConvexityClue": false,
      "requiredSourceTypes": ["official_or_direct_product_series"],
      "formedWhenAll": [
        "deterministic_project_contract_or_business_metric_mapping",
        "same_metric_definition_in_two_equal_completed_windows",
        "current_value_gte_5",
        "current_value_gte_previous_value_plus_3",
        "current_value_gte_previous_value_times_1_2",
        "growth_is_not_price_social_or_repository_star_count"
      ],
      "missingSeries": "path_unavailable_not_zero"
    },
    "supply_demand_structure_improvement": {
      "requiredForConvexityClue": false,
      "requiredSourceTypes": ["direct_chain_supply_or_holder_history", "market_pool_data"],
      "formedWhenAny": [
        "top10_holder_share_decreases_at_least_5_percentage_points_and_market_activity_not_below_p50",
        "holder_hhi_decreases_at_least_10_percent_and_market_activity_not_below_p50",
        "total_supply_decreases_at_least_0_5_percent_and_market_activity_not_below_p50"
      ],
      "unitScaleMustBeStable": true,
      "stableSupplyAloneFormsPath": false,
      "currentSnapshotOnly": "path_unavailable_not_zero"
    },
    "indexed_pool_activity_outpaces_supply_adjusted_valuation": {
      "requiredForConvexityClue": false,
      "requiredSourceTypes": ["market_pool_ohlcv", "direct_chain_historical_supply"],
      "activityLogChange": "ln((current_average_indexed_pool_volume_usd+1)/(previous_average_indexed_pool_volume_usd+1))",
      "valuationLogChange": "ln((current_volume_weighted_median_price_usd*current_total_supply)/(previous_volume_weighted_median_price_usd*previous_total_supply))",
      "relativeExpansion": "activityLogChange-valuationLogChange",
      "riskAdjustedSurplus": "activityLogChange-abs(valuationLogChange)",
      "formedWhenAll": [
        "all_provider_indexed_pools_have_required_ohlcv",
        "historical_total_supply_success",
        "supply_unit_scale_stable",
        "relative_expansion_gte_same_age_cohort_p60",
        "risk_adjusted_surplus_gt_0",
        "no_severe_q_anomaly"
      ],
      "unindexedDiscoveredPools": "display_count_and_reduce_confidence_not_zero_or_automatic_rejection",
      "literalGlobalAllPoolsClaimAllowed": false
    }
  },
  "convexityClue": {
    "hardGateMustPass": true,
    "minimumObservedFactors": 3,
    "minimumFormedStrongPaths": 2,
    "mandatoryPath": "trade_liquidity_formation",
    "secondPathAnyOf": [
      "verified_product_usage_expansion",
      "supply_demand_structure_improvement",
      "indexed_pool_activity_outpaces_supply_adjusted_valuation"
    ],
    "minimumIndependentSourceTypes": 2,
    "compositeScoreAloneCanTrigger": false
  },
  "activeProject": {
    "onlyWhenNotConvexityClue": true,
    "formedWhenAny": [
      "one_of_volume_transactions_volume_liquidity_ratio_gte_same_age_cohort_p70_with_observed_buy_and_sell",
      "qualifying_official_repository_has_non_document_own_commit_within_30_days",
      "verified_product_contract_or_business_metric_has_new_real_usage",
      "liquidity_above_age_floor_in_two_consecutive_completed_windows_and_drawdown_lt_50_percent"
    ],
    "priceIncreaseSocialFollowers_repositoryStarsAloneCanTrigger": false
  },
  "statePriority": [
    "data_limited",
    "convexity_clue",
    "active_project",
    "early_observation",
    "continuous_observation"
  ],
  "hysteresis": {
    "entry": "one_complete_evaluation_after_required_comparison_windows_exist",
    "normalExit": "two_consecutive_new_completed_evaluation_window_ids_below_exit_rule",
    "exitPercentile": 0.5,
    "sourceFailureCountsAsMiss": false,
    "hardGateFailureOrDay91Exit": "immediate",
