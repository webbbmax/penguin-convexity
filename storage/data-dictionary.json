{
  "version": "v20-c1.7",
  "title": "凸性系统数据字典",
  "principle": "RWA 与凸性数据完全隔离。原始证据不覆盖，状态变化保留历史，零结果必须说明原因。",
  "groups": [
    {
      "id": "operations",
      "label": "运行与反馈",
      "description": "回答后台有没有运行、采集了什么、为什么没有候选、哪条任务可以重试。",
      "tables": ["runs", "run_source_stats", "run_errors", "tracking_task_runs", "tracking_decision_reviews", "scan_run_scopes", "scan_results", "filter_decisions"]
    },
    {
      "id": "sources",
      "label": "来源与原始线索",
      "description": "登记数据从哪里来，并保存不可变的原始线索。",
      "tables": ["sources", "source_accounts", "raw_events", "evidence_lineage", "source_adapter_records", "project_monitoring_targets", "weak_signal_inbox", "source_discoveries"]
    },
    {
      "id": "data_backbone",
      "label": "C1.7 最大漏斗数据主干",
      "description": "把原始事件标准化为可回放、可诊断、可再归属的数据流，并编译项目、资产、合约、仓库、治理与 Watcher 关系。",
      "tables": ["normalized_events_v2", "source_cursors_v2", "event_replay_runs", "source_health_v2", "source_health_history", "orphan_events_v2", "event_attribution_history", "entity_nodes", "entity_edges", "watcher_definitions"]
    },
    {
      "id": "identity",
      "label": "项目、资产与交易性",
      "description": "把项目主体、可交易资产、多链合约身份、交易场所、市场数据和可退出性核验分开。",
      "tables": ["projects", "project_identity_aliases", "assets", "networks", "asset_contracts", "venues", "market_snapshots", "contract_risks", "tradeability_checks", "network_discoveries", "discovery_identity_reviews", "project_asset_identity_reviews"]
    },
    {
      "id": "research",
      "label": "凸性研究与决策",
      "description": "保存证据、候选状态、错配评分、凸性判断、告警和行动结论。",
      "tables": ["evidence_items", "candidate_cases", "mismatch_scores", "convexity_reviews", "machine_research_scores", "machine_conclusions", "catalyst_trade_paths", "state_transitions", "opportunity_stage_history", "alerts", "decision_reports"]
    },
    {
      "id": "review_publish",
      "label": "人工介入与发布",
      "description": "人工标注作为可撤回的覆盖层，公开发布使用独立快照，不直接改写自动采集原始记录。",
      "tables": ["manual_annotations", "publication_records"]
    },
    {
      "id": "feedback",
      "label": "结果复盘",
      "description": "根据真实结果衡量候选、来源和规则是否有效。",
      "tables": ["outcomes", "source_metrics", "schema_migrations"]
    }
  ],
  "tables": {
    "normalized_events_v2": {"label": "Event Schema v2", "purpose": "统一保存来源、实体、事件时间、采集时间、原始定位、内容哈希、证据等级、项目归属和处理状态；每条记录都回指不可变原始事件。"},
    "source_cursors_v2": {"label": "来源游标与断档状态", "purpose": "本地保存每个来源的增量游标、高水位、重放起点、积压、连续失败和断档区间。"},
    "event_replay_runs": {"label": "事件重放审计", "purpose": "不可变地记录增量、重放和断档恢复的输入、插入、更新、去重、孤儿与恢复结果。"},
    "source_health_v2": {"label": "来源健康当前状态", "purpose": "区分健康、真实零结果、静默采集、任务失败、额度耗尽、规则缺口、陈旧与未知。"},
    "source_health_history": {"label": "来源健康历史", "purpose": "不可变地保留来源健康诊断发生变化时的状态和原因。"},
    "orphan_events_v2": {"label": "孤儿证据收件箱", "purpose": "原始记录无法唯一归属项目时不丢弃，保留提示、冲突和后续再归属结果。"},
    "event_attribution_history": {"label": "事件归属历史", "purpose": "不可变地记录事件从未归属、冲突到项目或实体的每次归属变化。"},
    "entity_nodes": {"label": "实体图谱节点", "purpose": "统一登记项目、资产、合约、网络、仓库、治理、协议、发布与包实体。"},
    "entity_edges": {"label": "实体图谱关系", "purpose": "保存项目、资产、部署、仓库、治理、协议、发布和包之间的可追溯关系。"},
    "watcher_definitions": {"label": "Watcher 编译结果", "purpose": "把已核验实体编译为 Git、发布、包、EVM、Solana、治理、协议和网站监控目标，并保留阻断原因。"},
    "schema_migrations": {"label": "数据库版本", "purpose": "记录已经应用的数据结构版本，保证升级可追溯。"},
    "sources": {"label": "信源库", "purpose": "登记来源入口、可信度、利益冲突、运行状态和更新频率。"},
    "source_accounts": {"label": "来源账号", "purpose": "登记 X、GitHub、开发者、审计员等具体账号及独立关系。"},
    "runs": {"label": "运行记录", "purpose": "记录每次自动或手动运行的时间、结果、数量和零结果解释。"},
    "run_source_stats": {"label": "单来源运行明细", "purpose": "逐个信源记录采集、去重、匹配、过滤、入池和失败数量。"},
    "run_errors": {"label": "失败与重试", "purpose": "保存失败任务、错误原因、是否可重试和重试结果。"},
    "tracking_task_runs": {"label": "项目跟踪执行记录", "purpose": "逐项目保存自动检查过的信源、发现与未发现、结论变化、下次复查时间和单项目重试状态。"},
    "tracking_decision_reviews": {"label": "跟踪结论复核记录", "purpose": "追加保存上调或停止结论的确认、驳回、备注和证据；驳回后项目重新进入到期复查。"},
    "scan_run_scopes": {"label": "人工扫描范围", "purpose": "保存每次人工扫描选择的网络和信源，使失败任务可以按原范围单独重试。"},
    "scan_results": {"label": "逐链逐源扫描结果", "purpose": "按运行、网络和信源保留每一条扫描结果，支持查看不同链和来源发现了什么。"},
    "raw_events": {"label": "原始事件", "purpose": "保存不可变的原始线索、来源链接、时间和内容指纹。"},
    "evidence_lineage": {"label": "证据溯源关系", "purpose": "追加保存原始记录、研究证据、机器评分、机器结论和状态变化之间的引用关系；历史缺口只标记，不伪造补齐。"},
    "source_adapter_records": {"label": "主干适配审计", "purpose": "追加记录每条来源数据是否完成原始留存、证据连接、身份归属和历史缺口恢复，使不同采集器遵守同一生产合同。"},
    "project_monitoring_targets": {"label": "项目监控目标注册表", "purpose": "逐项目登记官网、X、GitHub、协议指标、治理空间、受益资产和合约；只有身份及来源关系通过的目标才能进入自动监控，旧版本保留为审计历史。"},
    "weak_signal_inbox": {"label": "弱线索统一收件箱", "purpose": "统一保存项目目录、公开代码、治理、链上痕迹和推广入口的当前归类与历史版本；线索只安排补证，不直接参与评分、结论或行动。"},
    "source_discoveries": {"label": "项目级来源发现", "purpose": "保存GitHub、DefiLlama和治理来源发现的项目主体线索，并将项目身份、资产身份和价值捕获分开归因。"},
    "filter_decisions": {"label": "过滤决定", "purpose": "记录每条线索为什么进入影子池、正式库、延期或被拒绝。"},
    "projects": {"label": "项目主体", "purpose": "保存项目名称、官网、代码仓库、团队和身份核验状态。"},
    "project_identity_aliases": {"label": "项目身份别名账本", "purpose": "保留项目名称、官网、来源ID、CoinGecko ID、代码库和合约等历史身份锚点，使自动生成的项目ID变化后仍可重绑定。"},
    "assets": {"label": "可交易资产", "purpose": "将项目与代币、链、合约和价值捕获关系分开记录。"},
    "networks": {"label": "网络注册表", "purpose": "登记主网与测试网、Chain ID、浏览器和凸性发现优先级，测试网不得冒充主网。"},
    "asset_contracts": {"label": "资产多链合约", "purpose": "一个资产可保留多个网络部署，并记录地址来源、身份状态和核验方法。"},
    "venues": {"label": "交易场所", "purpose": "记录 DEX/CEX、交易对、池地址以及是否能买入和卖出。"},
    "market_snapshots": {"label": "市场快照", "purpose": "按时间保存价格、流动性、成交、供应和退出滑点。"},
    "contract_risks": {"label": "合约风险", "purpose": "记录增发、冻结、税费、暂停、升级、持仓集中和撤池风险。"},
    "tradeability_checks": {"label": "可交易性核验", "purpose": "保存合约存在性、代码状态、交易池匹配、近期买卖、只读卖出路径和滑点证据。"},
    "network_discoveries": {"label": "常用链发现队列", "purpose": "保存常用主网自动发现的新合约及技术预检，只安排身份复核顺序，不直接产生投资结论。"},
    "discovery_identity_reviews": {"label": "发现身份复核", "purpose": "逐次保存合约、第三方资产注册、官网和既有项目之间的身份匹配结果，并记录是否仅升格到影子研究库。"},
    "project_asset_identity_reviews": {"label": "项目资产身份复核", "purpose": "逐项目保存 DefiLlama 项目登记与 CoinGecko 资产注册之间的自动匹配、冲突和待补证原因；项目存在不等于存在可购买代币。"},
    "evidence_items": {"label": "证据条目", "purpose": "区分确认事实、推断、项目方说法、未验证线索以及支持和反面证据。"},
    "candidate_cases": {"label": "凸性候选主记录", "purpose": "保存 L0-L5、工作状态、风险、剩余凸性、点火距离和当前动作。"},
    "mismatch_scores": {"label": "事实新闻错配评分", "purpose": "保存五项基础分、风险扣分和规则版本，只用于安排研究优先级。"},
    "convexity_reviews": {"label": "凸性专项判断", "purpose": "保存最大亏损、非线性上行、点火、衰减、失效和反面证据。"},
    "machine_research_scores": {"label": "机器研究评分", "purpose": "按早期、OG和潜力项目的不同研究权重保存证据质量、事实新闻错配与凸性准备度；三个分数均不直接产生行动建议。"},
    "machine_conclusions": {"label": "机器状态与结论", "purpose": "把最新机器评分和硬门槛转换为当前状态、行动结论、阻断原因、下一项自动任务、升级条件与失效条件；人工复核不阻断发布。"},
    "catalyst_trade_paths": {"label": "催化交易路径", "purpose": "逐项目保存可溯源催化、确认信号、受益资产、价值传导、市场与退出、失效条件和下一项机器任务；模型化2万美元滑点不得冒充真实成交。"},
    "state_transitions": {"label": "状态变化历史", "purpose": "每次升级、降级、点火、失效和移出都保留原因与证据。"},
    "opportunity_stage_history": {"label": "机会阶段变化历史", "purpose": "独立保存机会中心行动阶段及关键因子的比较基线、升级、降级和横向变化，不与研究工作流状态混用。"},
    "alerts": {"label": "机械告警", "purpose": "保存 P0/P1/P2 告警、去重键和处理状态。"},
    "decision_reports": {"label": "行动结论", "purpose": "保存只观察、试仓、减仓、退出或反身性管理结论。"},
    "manual_annotations": {"label": "人工标注", "purpose": "保存人工分类、纠错和备注，不覆盖自动采集事实，并支持撤回与审计。"},
    "publication_records": {"label": "发布记录", "purpose": "管理草稿、预览、发布和撤回状态，把项目母池与大众展示分开。"},
    "outcomes": {"label": "结果与反事实", "purpose": "跟踪结论后的价格路径、事实兑现、回撤、退出和失效。"},
    "source_metrics": {"label": "信源效果", "purpose": "按周期统计领先时间、候选转化、准确率和误报率。"}
  },
