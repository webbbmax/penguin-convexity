# Public repository boundary: keep local state, credentials, generated output,
# and user-specific research artifacts out of GitHub.

# Local runtime state, databases, backups, archives, and reports
runtime/
data/
backups/
archive/
reports/
storage/*.db
storage/*.db-*
*.db
*.db-*
*.sqlite
*.sqlite3
*.jsonl
*.log
*.cache
*.tmp
*.lock
*.bak

# Python and other local build/test caches
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# C2.3 .NET desktop build outputs (source and package locks remain trackable)
**/bin/
**/obj/
desktop-host/publish/

# Generated UI/data snapshots; source files remain trackable.
app/*-snapshot.js
app/*-snapshot.json
app/*-snapshot.html

# Credentials and local environment files
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
**/secrets/
**/*credentials*.json
**/*secret*.json
*.pem
*.pfx
*.p12
*.key

# API resource catalogs may contain provider-specific operational details.
config/shared-api-catalog.json
config/strong-signal-resource-catalog.json

# Formal project memory, decisions, migration records, and acceptance
# manifests are source-controlled after D0 secret scanning. Runtime evidence
# remains excluded by the rules above.

# Archives and packaged binaries
*.zip
*.7z
*.rar
*.exe
